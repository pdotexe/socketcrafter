{
  "name": "SocketCraft",
  "version": "1.0.0",
  "main": "interface/index.html",
  "chromium-args": "--disable-web-security --enable-features=WebGPU --ignore-gpu-blocklist",
  "window": {
    "title": "SocketCraft",
    "frame": false,
    "icon": "assets/logo.png"
  },
  "scripts": {
    "tail-build": "tailwindcss -i ./src/input.css -o ./interface/app.css",
    "tail-watch": "tailwindcss -i ./src/input.css -o ./interface/app.css --watch",
    "start": "nw ."
  },
  "dependencies": {
    "axios": "^1.18.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "nw": "^0.92.0",
    "tailwindcss": "^4.3.3"
  }
}
